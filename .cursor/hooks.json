{
    "version": 1,
    "lastModified": "2024-12-19",
    "hooks": {
        "afterAgentThought": [
            {
                "command": "./hooks/audit.sh"
            }
        ],
        "beforeShellExecution": [
            {
                "command": "jq -r '\"\\(.command) - \\(.tool_input.description // \"No description\")\"' >> ~/agent.log"
            },
            {
                "command": "./hooks/block-git.sh"
            }
        ],
        "beforeMCPExecution": [
            {
                "command": "./hooks/audit.sh"
            }
        ],
        "beforeReadFile": [
            {
                "command": "./hooks/audit.sh"
            }
        ],
        "afterFileEdit": [
            {
                "command": "./hooks/audit.sh"
            }
        ],
        "beforeSubmitPrompt": [
            // {
            //     "command": "./.cursor/hooks/no-continue.sh"
            // },
            // {
            //     "command": "./hooks/notify-on-submit.sh"
            // }
            {
                "command": "./hooks/audit.sh"
            }
        ],
        "afterAgentResponse": [
            {
                "command": "./hooks/audit.sh"
            }
        ],
        "afterMCPExecution": [
            {
                "command": "./hooks/audit.sh"
            }
        ],
        "afterShellExecution": [
            {
                "command": "./hooks/audit.sh"
            }
        ]
    }
}